[Unit]
Description=OpenFlight Golf Launch Monitor
# Not ordered after graphical.target: the unit is wanted by multi-user.target,
# which graphical.target follows, so that ordering is a cycle and systemd
# silently drops the start at boot. The launcher waits for the desktop itself.
After=network.target
# A launcher that fails during preparation exits within a second. Without a
# limit systemd retried it every 5 s indefinitely, and each attempt's cleanup
# killed the desktop session's kiosk. Five failures in five minutes stops the
# loop; `sudo systemctl reset-failed openflight` re-arms it after a fix.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=coleman
WorkingDirectory=/home/coleman/openflight
Environment=DISPLAY=:0
# Optional site settings, e.g. OPENFLIGHT_ARGS="--host 0.0.0.0 --altitude-ft 850".
EnvironmentFile=-/etc/default/openflight
ExecStart=/home/coleman/openflight/scripts/start-kiosk.sh $OPENFLIGHT_ARGS
Restart=on-failure
RestartSec=5
# A stop during an in-app update waits for its rollback (uv sync, npm ci)
# instead of SIGKILLing a half-installed checkout after the default 90 s.
TimeoutStopSec=1800
# Exit 3 means another OpenFlight instance already owns the kiosk (see
# acquire_instance_lock in scripts/start-kiosk.sh); retrying cannot help.
RestartPreventExitStatus=3
# The launcher exits 130 when stopped by SIGTERM/SIGINT (143 if killed by
# SIGTERM directly). A normal stop or restart must not leave the unit "failed".
SuccessExitStatus=130 143

[Install]
# multi-user.target so a headless (Pi OS Lite) install starts too; on a
# desktop image graphical.target pulls multi-user.target in.
WantedBy=multi-user.target
